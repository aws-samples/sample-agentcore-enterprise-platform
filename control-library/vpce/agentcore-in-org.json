{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAgentCoreFromOrgOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "bedrock-agentcore:InvokeAgentRuntime",
        "bedrock-agentcore:InvokeAgentRuntimeForUser",
        "bedrock-agentcore:InvokeGateway"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "<<org_id>>"
        }
      }
    },
    {
      "Sid": "DenyEverythingOutsideOrg",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalOrgID": "<<org_id>>"
        }
      }
    }
  ]
}
