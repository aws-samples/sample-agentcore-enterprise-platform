{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonApprovedGatewayProtocol",
      "Effect": "Deny",
      "Action": [
        "bedrock-agentcore:CreateGateway",
        "bedrock-agentcore:UpdateGateway"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "bedrock-agentcore:ProtocolType": "<<allowed_protocol>>"
        },
        "Null": {
          "bedrock-agentcore:ProtocolType": "false"
        }
      }
    }
  ]
}
