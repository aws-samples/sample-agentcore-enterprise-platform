{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonApprovedMcpTargetTypes",
      "Effect": "Deny",
      "Action": [
        "bedrock-agentcore:CreateGatewayTarget",
        "bedrock-agentcore:UpdateGatewayTarget"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "bedrock-agentcore:McpTargetConfigurationType": [
            "lambda",
            "mcpServer"
          ]
        },
        "Null": {
          "bedrock-agentcore:McpTargetConfigurationType": "false"
        }
      }
    }
  ]
}
