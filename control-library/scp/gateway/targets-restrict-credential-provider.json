{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDisallowedTargetCredentialProviders",
      "Effect": "Deny",
      "Action": [
        "bedrock-agentcore:CreateGatewayTarget",
        "bedrock-agentcore:UpdateGatewayTarget"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "bedrock-agentcore:CredentialProviderType": [
            "API_KEY",
            "JWT_PASSTHROUGH"
          ]
        }
      }
    }
  ]
}
