{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyGatewayWithoutPolicyEngine",
      "Effect": "Deny",
      "Action": [
        "bedrock-agentcore:CreateGateway",
        "bedrock-agentcore:UpdateGateway"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "bedrock-agentcore:PolicyEngineArn": "true"
        }
      }
    },
    {
      "Sid": "DenyGatewayPolicyEngineNotEnforced",
      "Effect": "Deny",
      "Action": [
        "bedrock-agentcore:CreateGateway",
        "bedrock-agentcore:UpdateGateway"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "bedrock-agentcore:PolicyEngineMode": "ENFORCE"
        }
      }
    }
  ]
}
