{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyGatewayTargetWithoutPrivateEndpoint",
      "Effect": "Deny",
      "Action": [
        "bedrock-agentcore:CreateGatewayTarget",
        "bedrock-agentcore:UpdateGatewayTarget"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "bedrock-agentcore:PrivateEndpointType": "true"
        }
      }
    }
  ]
}
