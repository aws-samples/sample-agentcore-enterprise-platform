diff --git a/tests/test_adapter.py b/tests/test_adapter.py
index 40af9e9..b502958 100644
--- a/tests/test_adapter.py
+++ b/tests/test_adapter.py
@@ -399,3 +399,60 @@ def test_invoke_preserves_forwarding_after_health_check(monkeypatch):
         "payload": {"prompt": "hi"},
         "url": adapter._invoke_url(),
     }
+
+
+# ── restart budget ──
+class _FakeProc:
+    def __init__(self, rc=1):
+        self.returncode = rc
+        self.stderr = iter(())
+
+    def wait(self):
+        return self.returncode
+
+    def poll(self):
+        return self.returncode
+
+
+def _child_with_fake_procs(monkeypatch, limit):
+    child = adapter.Child(["agent"], {}, restart_limit=limit)
+    started = []
+
+    def fake_start():
+        started.append(len(started))
+        child.proc = _FakeProc()
+
+    monkeypatch.setattr(child, "start", fake_start)
+    child.proc = _FakeProc()
+    return child, started
+
+
+def test_default_restart_limit_is_one():
+    assert adapter.Child(["agent"], {}).restart_limit == 1
+
+
+def test_child_gives_up_and_reports_unhealthy(monkeypatch):
+    child, started = _child_with_fake_procs(monkeypatch, limit=1)
+    child.supervise()
+    assert child.unhealthy is True
+    assert child.restarts_used == 1
+    assert child.alive() is False
+
+
+def test_restart_limit_two_allows_two_restarts(monkeypatch):
+    child, started = _child_with_fake_procs(monkeypatch, limit=2)
+    child.supervise()
+    assert child.restarts_used == 2
+    assert child.unhealthy is True
+
+
+def test_restart_limit_zero_never_counts_a_restart(monkeypatch):
+    child, started = _child_with_fake_procs(monkeypatch, limit=0)
+    child.supervise()
+    assert child.restarts_used == 0
+    assert child.unhealthy is True
+
+
+def test_restart_limit_is_read_from_the_environment(monkeypatch):
+    monkeypatch.setenv("MIGRATION_RESTART_LIMIT", "3")
+    assert int(adapter.os.environ["MIGRATION_RESTART_LIMIT"]) == 3
