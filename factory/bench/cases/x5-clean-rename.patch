+# ── stderr tail and liveness ──
+def test_stderr_tail_keeps_only_the_last_lines():
+    proc = adapter.ChildProcess(["agent"], {})
+    for i in range(adapter.STDERR_TAIL_LINES + 10):
+        proc.stderr_tail.append(f"line {i}")
+    assert len(proc.stderr_tail) == adapter.STDERR_TAIL_LINES
+    assert proc.stderr_tail[0] == "line 10"
+
+
+def test_not_started_child_is_not_alive():
+    assert adapter.ChildProcess(["agent"], {}).alive() is False
+
+
+def test_unhealthy_child_is_not_alive_even_if_running():
+    class Running:
+        def poll(self):
+            return None
+
+    proc = adapter.ChildProcess(["agent"], {})
+    proc.proc = Running()
+    assert proc.alive() is True
+    proc.unhealthy = True
+    assert proc.alive() is False
+
+
+def test_exited_child_is_not_alive():
+    class Exited:
+        def poll(self):
+            return 1
+
+    proc = adapter.ChildProcess(["agent"], {})
+    proc.proc = Exited()
+    assert proc.alive() is False
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [("1.5", 1.5), ("0", adapter.LIVE_HEALTH_TIMEOUT_DEFAULT), ("-3", adapter.LIVE_HEALTH_TIMEOUT_DEFAULT),
+     ("nan", adapter.LIVE_HEALTH_TIMEOUT_DEFAULT), ("inf", adapter.LIVE_HEALTH_TIMEOUT_DEFAULT),
+     ("abc", adapter.LIVE_HEALTH_TIMEOUT_DEFAULT), ("99", adapter.LIVE_HEALTH_TIMEOUT_MAX)],
+)
+def test_live_health_timeout_bounds(value, expected):
+    assert adapter.live_health_timeout({"MIGRATION_LIVE_HEALTH_TIMEOUT": value}) == expected
+
+
+def test_live_health_timeout_default_when_unset():
+    assert adapter.live_health_timeout({}) == adapter.LIVE_HEALTH_TIMEOUT_DEFAULT
+
+
+# ── migration_env contract ──
+def test_migration_env_prefers_json_over_pairs():
+    env = {"MIGRATION_ENV_JSON": '{"A": "json"}', "MIGRATION_ENV": "A=pairs,B=2"}
+    assert adapter.migration_env(env) == {"A": "json"}
+
+
+def test_migration_env_falls_back_to_pairs():
+    assert adapter.migration_env({"MIGRATION_ENV": "A=1,B=2"}) == {"A": "1", "B": "2"}
+
+
+def test_migration_env_empty_when_nothing_declared():
+    assert adapter.migration_env({}) == {}
+
+
+def test_migration_env_empty_json_object():
+    assert adapter.migration_env({"MIGRATION_ENV_JSON": "{}"}) == {}
+
+
+def test_secret_id_for_uses_the_platform_convention():
+    env = {"PROJECT_NAME": "proj", "ENVIRONMENT": "dev"}
+    assert adapter.secret_id_for("JIRA_TOKEN", env) == "proj/dev/migration/JIRA_TOKEN"
+
+
+def test_secret_id_for_honours_explicit_arns():
+    env = {"MIGRATION_SECRET_ARNS": "JIRA_TOKEN=arn:aws:secretsmanager:us-east-1:1:secret:jira-abc"}
+    assert adapter.secret_id_for("JIRA_TOKEN", env).endswith("jira-abc")
+
+
+def test_resolve_secrets_without_declarations_needs_no_client():
+    assert adapter.resolve_secrets({}, client=None) == {}
+
+
+def test_resolve_secrets_names_the_missing_secret():
+    class Failing:
+        def get_secret_value(self, SecretId):
+            raise KeyError(SecretId)
+
+    with pytest.raises(RuntimeError, match="JIRA_TOKEN"):
+        adapter.resolve_secrets({"MIGRATION_SECRETS": "JIRA_TOKEN"}, client=Failing())
