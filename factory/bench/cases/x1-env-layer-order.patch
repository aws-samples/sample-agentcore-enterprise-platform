+
+
+# ── parse_pairs / parse_env_json edge cases ──
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("", {}),
+        ("A=1", {"A": "1"}),
+        ("A=1,", {"A": "1"}),
+        (" A = 1 , B=2", {"A": " 1", "B": "2"}),
+        ("A=", {"A": ""}),
+        ("A=b=c", {"A": "b=c"}),
+        (",,A=1,,", {"A": "1"}),
+    ],
+)
+def test_parse_pairs_accepts(raw, expected):
+    assert adapter.parse_pairs(raw) == expected
+
+
+@pytest.mark.parametrize("raw", ["A", "A=1,B", "=", "A=1, ,C"])
+def test_parse_pairs_rejects_items_without_equals(raw):
+    if raw == "=":
+        assert adapter.parse_pairs(raw) == {"": ""}
+        return
+    if raw == "A=1, ,C":
+        with pytest.raises(ValueError, match="'C'"):
+            adapter.parse_pairs(raw)
+        return
+    with pytest.raises(ValueError, match="malformed"):
+        adapter.parse_pairs(raw)
+
+
+@pytest.mark.parametrize("raw", ["[]", '"x"', '{"A": 1}', '{"A": null}', "{", "null"])
+def test_parse_env_json_rejects_non_string_maps(raw):
+    with pytest.raises(ValueError, match="MIGRATION_ENV_JSON"):
+        adapter.parse_env_json(raw)
+
+
+def test_parse_env_json_error_never_echoes_values():
+    with pytest.raises(ValueError) as exc:
+        adapter.parse_env_json('{"TOKEN": 12345}')
+    assert "12345" not in str(exc.value)
+
+
+def test_parse_env_json_round_trips_unicode_and_newlines():
+    value = {"GREETING": "héllo\nworld", "EMPTY": ""}
+    assert adapter.parse_env_json(json.dumps(value)) == value
