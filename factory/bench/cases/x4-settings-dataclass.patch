diff --git a/tests/test_adapter.py b/tests/test_adapter.py
index 40af9e9..fcf2f22 100644
--- a/tests/test_adapter.py
+++ b/tests/test_adapter.py
@@ -399,3 +399,55 @@ def test_invoke_preserves_forwarding_after_health_check(monkeypatch):
         "payload": {"prompt": "hi"},
         "url": adapter._invoke_url(),
     }
+
+
+# ── MigrationSettings ──
+FULL_ENV = {
+    "PROJECT_NAME": "proj",
+    "ENVIRONMENT": "dev",
+    "MIGRATION_PORT": "9000",
+    "MIGRATION_INVOKE_PATH": "/run",
+    "MIGRATION_HEALTH_PATH": "/healthz",
+    "MIGRATION_SECRETS": "JIRA_TOKEN, GIT_TOKEN,",
+    "MIGRATION_SECRET_ARNS": "GIT_TOKEN=arn:aws:secretsmanager:us-east-1:1:secret:custom-abc",
+    "MIGRATION_STARTUP_TIMEOUT": "15",
+}
+
+
+def test_settings_parse_every_field():
+    s = adapter.MigrationSettings.from_environ(FULL_ENV)
+    assert s.project == "proj" and s.environment == "dev"
+    assert (s.port, s.invoke_path, s.health_path) == ("9000", "/run", "/healthz")
+    assert s.secret_names == ("JIRA_TOKEN", "GIT_TOKEN")
+    assert s.secret_arns["GIT_TOKEN"].endswith("custom-abc")
+    assert s.startup_timeout == 15.0
+
+
+def test_settings_defaults_for_the_child_contract():
+    s = adapter.MigrationSettings.from_environ({})
+    assert (s.port, s.invoke_path, s.health_path) == ("8000", "/invocations", "")
+    assert s.secret_names == () and s.secret_arns == {}
+    assert s.startup_timeout == 60.0
+
+
+def test_urls_follow_settings(monkeypatch):
+    for key, value in FULL_ENV.items():
+        monkeypatch.setenv(key, value)
+    assert adapter._invoke_url() == "http://127.0.0.1:9000/run"
+    assert adapter._health_url() == "http://127.0.0.1:9000/healthz"
+
+
+def test_health_url_defaults_to_root(monkeypatch):
+    monkeypatch.delenv("MIGRATION_HEALTH_PATH", raising=False)
+    assert adapter._health_url().endswith("/")
+
+
+def test_settings_are_frozen():
+    s = adapter.MigrationSettings.from_environ(FULL_ENV)
+    with pytest.raises(AttributeError):
+        s.port = "1"
+
+
+def test_secret_id_uses_explicit_arn_override():
+    assert adapter.secret_id_for("GIT_TOKEN", FULL_ENV).endswith("custom-abc")
+    assert adapter.secret_id_for("JIRA_TOKEN", FULL_ENV) == "proj/dev/migration/JIRA_TOKEN"
