diff --git a/tests/test_jwt_claims.py b/tests/test_jwt_claims.py
index 3c3d9e2..eebe6b0 100644
--- a/tests/test_jwt_claims.py
+++ b/tests/test_jwt_claims.py
@@ -86,3 +86,75 @@ def test_no_allowed_clients_still_pins_the_issuer():
 def test_empty_claims_are_rejected():
     with pytest.raises(TokenRejected):
         validate_claims({}, ISSUER, CLIENTS)
+
+
+# ── helpers kept behaviour-identical to validate_claims ──
+from jwt_claims import _client_id, jwks_uri, gateway_token_scopes  # noqa: E402
+
+
+@pytest.mark.parametrize(
+    ("claims", "expected"),
+    [
+        ({"aud": "a"}, "a"),
+        ({"aud": ["a", "b"]}, "a"),
+        ({"aud": []}, None),
+        ({"client_id": "m2m"}, "m2m"),
+        ({"aud": "", "client_id": "m2m"}, "m2m"),
+        ({}, None),
+    ],
+)
+def test_client_id_sources(claims, expected):
+    assert _client_id(claims) == expected
+
+
+def test_issuer_with_trailing_slash_is_not_the_same_issuer():
+    claims = {"iss": ISSUER + "/", "aud": APP_CLIENT, "sub": "user-1"}
+    with pytest.raises(TokenRejected, match="issuer"):
+        validate_claims(claims, ISSUER, CLIENTS)
+
+
+def test_missing_issuer_claim_is_rejected():
+    with pytest.raises(TokenRejected, match="issuer"):
+        validate_claims({"aud": APP_CLIENT, "sub": "user-1"}, ISSUER, CLIENTS)
+
+
+def test_empty_subject_is_rejected():
+    with pytest.raises(TokenRejected, match="sub"):
+        validate_claims({"iss": ISSUER, "aud": APP_CLIENT, "sub": ""}, ISSUER, CLIENTS)
+
+
+def test_client_check_runs_before_subject_check():
+    claims = {"iss": ISSUER, "client_id": "other"}
+    with pytest.raises(TokenRejected, match="client"):
+        validate_claims(claims, ISSUER, CLIENTS)
+
+
+def test_jwks_uri_prefers_discovery():
+    assert jwks_uri(ISSUER, {"jwks_uri": "https://keys"}) == "https://keys"
+    assert jwks_uri(ISSUER + "/") == ISSUER + "/.well-known/jwks.json"
+
+
+def test_gateway_scopes_skip_empty_items():
+    assert gateway_token_scopes({"GATEWAY_TOKEN_SCOPES": "a,,b,"}) == ["a", "b"]
+    assert gateway_token_scopes({}) == []
+
+
+def test_m2m_token_with_aud_list_uses_first_audience():
+    claims = {"iss": ISSUER, "aud": [M2M_CLIENT, "other"], "sub": "svc"}
+    assert validate_claims(claims, ISSUER, CLIENTS) == "svc"
+
+
+def test_any_client_from_the_issuer_when_no_clients_pinned():
+    claims = {"iss": ISSUER, "client_id": "whatever", "sub": "svc"}
+    assert validate_claims(claims, ISSUER, ()) == "svc"
+
+
+def test_rejections_are_value_errors_for_callers():
+    assert issubclass(TokenRejected, ValueError)
+
+
+@pytest.mark.parametrize("bad_issuer", ["", "https://cognito-idp.us-east-1.amazonaws.com", ISSUER.upper()])
+def test_near_miss_issuers_are_rejected(bad_issuer):
+    claims = {"iss": bad_issuer, "aud": APP_CLIENT, "sub": "user-1"}
+    with pytest.raises(TokenRejected):
+        validate_claims(claims, ISSUER, CLIENTS)
