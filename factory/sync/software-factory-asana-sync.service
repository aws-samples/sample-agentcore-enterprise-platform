# systemd user unit: one pass of the Asana sync. Installed by factory/sync/README.md.
[Unit]
Description=Software factory Asana sync (outbox -> board, board -> snapshot)

[Service]
Type=oneshot
# FACTORY_ASANA_PROJECT=<gid> lives here, not in the repo.
EnvironmentFile=%h/.config/software-factory/asana-sync.env
Environment=AWS_CONFIG_FILE=%h/.config/software-factory/aws-config
Environment=AWS_PROFILE=factory-asana-sync
# enterprise-asana-mcp and isengardcli are toolbox tools; uv provides Python 3.13 and boto3.
Environment=PATH=%h/.toolbox/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/repos/sample-agentcore-enterprise-platform
ExecStart=%h/.local/bin/uv run --quiet --no-project --python 3.13 --with boto3 python factory/sync/asana_sync.py
TimeoutStartSec=10min
