        <mxCell id="fed-note" value="Federated by design: the workload keeps its own agent identity and memory. Trust to the platform account is OAuth only — no cross-account IAM on the request path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#879196;fontColor=#5A6C86;fontSize=12;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
