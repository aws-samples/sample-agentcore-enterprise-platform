<mxfile host="app.diagrams.net" agent="kiro" type="device">
  <diagram id="agentcore-ai-landing-zone" name="AI Landing Zone">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AI Landing Zone for agents on Amazon Bedrock AgentCore" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="18" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Every block is a module you can deploy on its own. Profiles choose the sequence; teams own the colours." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="900" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Who owns what&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0972D3&quot;&gt;■&lt;/font&gt; platform team&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#01A88D&quot;&gt;■&lt;/font&gt; agent team&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#DD344C&quot;&gt;■&lt;/font&gt; security team&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#E7157B&quot;&gt;■&lt;/font&gt; org / governance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="18" width="340" height="56" as="geometry" />
