<mxfile host="app.diagrams.net" agent="kiro" type="device">
  <diagram id="agentcore-accelerator-overview" name="Overview">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Enterprise Agentic AI Platform Accelerator" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A governed foundation for production agents on Amazon Bedrock AgentCore" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="60" y="52" width="700" height="22" as="geometry" />
        </mxCell>

        <!-- ── deploy band ── -->
        <mxCell id="deploy" value="&lt;b&gt;One command to deploy&lt;/b&gt;&amp;nbsp; · &amp;nbsp;profiles (greenfield · migration · multi-agent · platform-team · security-focused) &amp;nbsp;·&amp;nbsp; or by team, module, or CI/CD &amp;nbsp;·&amp;nbsp; agent containers built for you in AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#232F3E;fontColor=#232F3E;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1080" height="60" as="geometry" />
        </mxCell>

